# Copy to .env.local. This example contains no credentials.
# Project Settings / Data API: your official project origin, without /rest/v1.
SUPABASE_URL=
# Server-only: never place this variable in dist/ or a browser bundle.
SUPABASE_SECRET_KEY=
# Allow this origin's /auth/callback in Supabase Authentication URL settings.
APP_ORIGIN=http://127.0.0.1:4173
